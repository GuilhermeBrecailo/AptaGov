{
  "name": "licitacoes-pncp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n painel,worker -c cyan,magenta \"npm:dev:painel\" \"npm:dev:worker\"",
    "dev:painel": "nuxt dev --host",
    "dev:worker": "tsx src/worker.ts",
    "build": "nuxt build",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "e2e:real": "tsx scripts/e2e-real.ts",
    "e2e:operational-real": "tsx scripts/e2e-operational-real.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "nuxt": "^4.0.0",
    "pino": "^9.7.0",
    "vue": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
